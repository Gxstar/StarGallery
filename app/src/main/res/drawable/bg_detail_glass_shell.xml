<?xml version="1.0" encoding="utf-8"?>
<!-- 详情页浮动玻璃块的「白纱」层（仿 iOS 26 相册的独立胶囊/圆钮）。
     圆角给一个远超尺寸的半径（100dp），绘制时会被系统裁到「短边的一半」：
     46dp 方形 ⇒ 正圆；46dp 高的胶囊 ⇒ 两端半圆，一套 drawable 通吃两种形状。
     必须只有一层白：LiquidGlassView 自身不挂背景，白色只在次层承担。 -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/detail_glass_fill" />
    <stroke
        android:width="0.5dp"
        android:color="@color/detail_glass_stroke" />
    <corners android:radius="100dp" />
</shape>
