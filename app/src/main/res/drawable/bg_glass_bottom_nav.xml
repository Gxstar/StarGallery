<?xml version="1.0" encoding="utf-8"?>
<!-- 平板左侧导航栏的玻璃面板（静态材质，rail 不与内容重叠、无法采样真实背景）。
     配色与详情页/底部导航的薄白纱同一套：detail_glass_fill + detail_glass_stroke，
     顶部高光保留一道静态「玻璃上缘折光」。 -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- 层 1：薄白纱基底 -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/detail_glass_fill" />
            <corners android:radius="28dp" />
        </shape>
    </item>

    <!-- 层 2：顶部高光 -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="90"
                android:endColor="@android:color/transparent"
                android:startColor="@color/glass_nav_highlight"
                android:type="linear" />
            <corners android:radius="28dp" />
        </shape>
    </item>

    <!-- 层 3：描边 -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@android:color/transparent" />
            <stroke
                android:width="0.5dp"
                android:color="@color/detail_glass_stroke" />
            <corners android:radius="28dp" />
        </shape>
    </item>

</layer-list>
