<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rootLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface">

    <androidx.fragment.app.FragmentContainerView
        android:id="@+id/nav_host_fragment"
        android:name="androidx.navigation.fragment.NavHostFragment"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:defaultNavHost="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/navigation_rail"
        app:layout_constraintTop_toTopOf="parent"
        app:navGraph="@navigation/nav_graph" />

    <!-- 平板（sw600dp+）左侧导航栏，替代底部导航；手机端默认隐藏 -->
    <com.google.android.material.navigationrail.NavigationRailView
        android:id="@+id/navigation_rail"
        android:layout_width="wrap_content"
        android:layout_height="0dp"
        android:layout_margin="8dp"
        android:background="@drawable/bg_glass_bottom_nav"
        android:visibility="gone"
        app:menu="@menu/bottom_nav_menu"
        app:labelVisibilityMode="labeled"
        app:itemActiveIndicatorStyle="@style/GlassActiveIndicator"
        app:itemIconSize="24dp"
        app:itemIconTint="@color/bottom_nav_color"
        app:itemTextColor="@color/bottom_nav_color"
        app:itemTextAppearanceActive="@style/BottomNavText"
        app:itemTextAppearanceInactive="@style/BottomNavText"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- iOS 26 式浮动液态玻璃导航条，尺寸与材质对齐系统相册（HyperOS）：
         紧凑药丸（只包住两个 tab，不再横跨全屏）、近白不透明底色、浅灰实心选中镜片。 -->
    <!-- 不用 Material BottomNavigationView：它需要 ≥96dp 才显示标签，条身过厚。
         这里自绘 2 个导航项，高度压到 56dp（系统相册实测约 52dp），字号与配色完全可控。 -->
    <com.example.liquidglass.LiquidGlassView
        android:id="@+id/bottom_nav_glass"
        android:layout_width="176dp"
        android:layout_height="56dp"
        android:background="@drawable/bg_nav_outline"
        android:layout_marginBottom="12dp"
        app:adaptiveTint="true"
        app:blurAmount="0.08"
        app:cornerRadius="28dp"
        app:glassMaterial="regular"
        app:glassTint="@color/nav_glass_tint"
        app:glassTintStrength="0.5"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:background="@drawable/bg_detail_glass_shell"
            android:orientation="horizontal"
            android:paddingStart="4dp"
            android:paddingEnd="4dp">

            <LinearLayout
                android:id="@+id/navItemPhotos"
                android:layout_width="84dp"
                android:layout_height="match_parent"
                android:background="@drawable/bg_nav_item_pill"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="vertical">

                <ImageView
                    android:id="@+id/ivNavPhotos"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:contentDescription="@string/nav_photos"
                    android:src="@drawable/ic_photos" />

                <TextView
                    android:id="@+id/tvNavPhotos"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:maxLines="1"
                    android:text="@string/nav_photos"
                    android:textSize="12sp"
                    android:textFontWeight="500" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/navItemAlbums"
                android:layout_width="84dp"
                android:layout_height="match_parent"
                android:background="@drawable/bg_nav_item_pill"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="vertical">

                <ImageView
                    android:id="@+id/ivNavAlbums"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:contentDescription="@string/nav_albums"
                    android:src="@drawable/ic_albums" />

                <TextView
                    android:id="@+id/tvNavAlbums"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:maxLines="1"
                    android:text="@string/nav_albums"
                    android:textSize="12sp"
                    android:textFontWeight="500" />
            </LinearLayout>

        </LinearLayout>

    </com.example.liquidglass.LiquidGlassView>

</androidx.constraintlayout.widget.ConstraintLayout>
