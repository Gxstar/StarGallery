<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rootContainer"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface">

    <!-- ViewPager2 with no clipping to fill entire screen -->
    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/viewPager"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- ==================== 顶部：三枚独立悬浮玻璃块 ====================
         仿 iOS 26/27 相册：不再是整幅贴边的长条，而是「返回圆钮 + 日期胶囊 + 更多圆钮」
         三块各自成形的玻璃悬浮在照片上。状态栏高度由代码加到 topOverlay 的 paddingTop。 -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/topOverlay"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <!-- 返回：正圆玻璃钮 -->
        <com.example.liquidglass.LiquidGlassView
            android:id="@+id/glassBack"
            android:layout_width="46dp"
            android:layout_height="46dp"
            android:layout_marginStart="18dp"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="6dp"
            app:adaptiveTint="true"
            app:blurAmount="0.08"
            app:cornerRadius="23dp"
            app:glassMaterial="regular"
            app:glassTint="@color/nav_glass_tint"
            app:glassTintStrength="0.5"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <ImageButton
                android:id="@+id/btnBack"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/bg_detail_glass_shell"
                android:contentDescription="@string/back"
                android:foreground="?attr/selectableItemBackgroundBorderless"
                android:scaleType="centerInside"
                android:src="@drawable/ic_chevron_left"
                android:tint="@color/nav_item_active" />

        </com.example.liquidglass.LiquidGlassView>

        <!-- 日期 + 时间：居中胶囊 -->
        <com.example.liquidglass.LiquidGlassView
            android:id="@+id/glassDateCapsule"
            android:layout_width="wrap_content"
            android:layout_height="46dp"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="12dp"
            app:adaptiveTint="true"
            app:blurAmount="0.08"
            app:cornerRadius="23dp"
            app:glassMaterial="regular"
            app:glassTint="@color/nav_glass_tint"
            app:glassTintStrength="0.5"
            app:layout_constraintBottom_toBottomOf="@id/glassBack"
            app:layout_constraintEnd_toStartOf="@id/glassMore"
            app:layout_constraintStart_toEndOf="@id/glassBack"
            app:layout_constraintTop_toTopOf="@id/glassBack"
            app:layout_constraintWidth_max="210dp">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:background="@drawable/bg_detail_glass_shell"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingStart="20dp"
                android:paddingEnd="20dp">

                <TextView
                    android:id="@+id/tvDate"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="@color/nav_item_active"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvInfo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="@color/detail_glass_text_secondary"
                    android:textSize="12sp"
                    android:textStyle="bold" />

            </LinearLayout>

        </com.example.liquidglass.LiquidGlassView>

        <!-- 更多：正圆玻璃钮 -->
        <com.example.liquidglass.LiquidGlassView
            android:id="@+id/glassMore"
            android:layout_width="46dp"
            android:layout_height="46dp"
            android:layout_marginEnd="18dp"
            app:adaptiveTint="true"
            app:blurAmount="0.08"
            app:cornerRadius="23dp"
            app:glassMaterial="regular"
            app:glassTint="@color/nav_glass_tint"
            app:glassTintStrength="0.5"
            app:layout_constraintBottom_toBottomOf="@id/glassBack"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@id/glassBack">

            <ImageButton
                android:id="@+id/btnMore"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/bg_detail_glass_shell"
                android:contentDescription="@string/more_options"
                android:foreground="?attr/selectableItemBackgroundBorderless"
                android:scaleType="centerInside"
                android:src="@drawable/ic_more"
                android:tint="@color/nav_item_active" />

        </com.example.liquidglass.LiquidGlassView>

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- ==================== 底部：胶片条 + 三块悬浮玻璃工具 ==================== -->
    <LinearLayout
        android:id="@+id/bottomOverlay"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:orientation="vertical">

        <!-- 缩略图胶片条：可超出屏幕左右边界（clipToPadding=false） -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/filmstrip"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:clipToPadding="false"
            android:overScrollMode="never"
            android:paddingStart="18dp"
            android:paddingEnd="18dp"
            android:scrollbars="none" />

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/bottomBar"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:layout_marginTop="14dp">

            <!-- 分享：正圆玻璃钮 -->
            <com.example.liquidglass.LiquidGlassView
                android:id="@+id/glassShare"
                android:layout_width="46dp"
                android:layout_height="46dp"
                android:layout_marginStart="18dp"
                app:adaptiveTint="true"
                app:blurAmount="0.08"
                app:cornerRadius="23dp"
                app:glassMaterial="regular"
                app:glassTint="@color/nav_glass_tint"
                app:glassTintStrength="0.5"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">

                <ImageButton
                    android:id="@+id/btnSend"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/bg_detail_glass_shell"
                    android:contentDescription="@string/send"
                    android:foreground="?attr/selectableItemBackgroundBorderless"
                    android:scaleType="centerInside"
                    android:src="@drawable/ic_share_ios"
                    android:tint="@color/nav_item_active" />

            </com.example.liquidglass.LiquidGlassView>

            <!-- 收藏 / 信息 / 编辑：居中三键胶囊（无文字，纯图标） -->
            <com.example.liquidglass.LiquidGlassView
                android:id="@+id/glassActions"
                android:layout_width="wrap_content"
                android:layout_height="46dp"
                app:adaptiveTint="true"
                app:blurAmount="0.08"
                app:cornerRadius="23dp"
                app:glassMaterial="regular"
                app:glassTint="@color/nav_glass_tint"
                app:glassTintStrength="0.5"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:background="@drawable/bg_detail_glass_shell"
                    android:orientation="horizontal"
                    android:paddingStart="6dp"
                    android:paddingEnd="6dp">

                    <FrameLayout
                        android:id="@+id/btnFavorite"
                        android:layout_width="52dp"
                        android:layout_height="match_parent"
                        android:background="?attr/selectableItemBackgroundBorderless">

                        <ImageView
                            android:id="@+id/ivFavorite"
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:layout_gravity="center"
                            android:contentDescription="@string/favorite"
                            android:src="@drawable/ic_favorite"
                            android:tint="@color/nav_item_active" />

                    </FrameLayout>

                    <FrameLayout
                        android:id="@+id/btnInfo"
                        android:layout_width="52dp"
                        android:layout_height="match_parent"
                        android:background="?attr/selectableItemBackgroundBorderless">

                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:layout_gravity="center"
                            android:contentDescription="@string/info"
                            android:src="@drawable/ic_info"
                            android:tint="@color/nav_item_active" />

                    </FrameLayout>

                    <FrameLayout
                        android:id="@+id/btnEdit"
                        android:layout_width="52dp"
                        android:layout_height="match_parent"
                        android:background="?attr/selectableItemBackgroundBorderless">

                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:layout_gravity="center"
                            android:contentDescription="@string/edit"
                            android:src="@drawable/ic_sliders"
                            android:tint="@color/nav_item_active" />

                    </FrameLayout>

                </LinearLayout>

            </com.example.liquidglass.LiquidGlassView>

            <!-- 删除：正圆玻璃钮 -->
            <com.example.liquidglass.LiquidGlassView
                android:id="@+id/glassDelete"
                android:layout_width="46dp"
                android:layout_height="46dp"
                android:layout_marginEnd="18dp"
                app:adaptiveTint="true"
                app:blurAmount="0.08"
                app:cornerRadius="23dp"
                app:glassMaterial="regular"
                app:glassTint="@color/nav_glass_tint"
                app:glassTintStrength="0.5"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent">

                <ImageButton
                    android:id="@+id/btnDelete"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/bg_detail_glass_shell"
                    android:contentDescription="@string/delete"
                    android:foreground="?attr/selectableItemBackgroundBorderless"
                    android:scaleType="centerInside"
                    android:src="@drawable/ic_trash_outline"
                    android:tint="@color/nav_item_active" />

            </com.example.liquidglass.LiquidGlassView>

        </androidx.constraintlayout.widget.ConstraintLayout>

    </LinearLayout>

</FrameLayout>
